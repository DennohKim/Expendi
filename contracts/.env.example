# Base Sepolia Deployment Configuration
PRIVATE_KEY=0x... # Your wallet private key (for deployment)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=... # Optional: For contract verification on Basescan

# Base Mainnet Configuration (for future use)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Security Note: 
# 1. Never commit your actual .env file to version control
# 2. Copy this to .env and fill in your actual values
# 3. Make sure .env is in your .gitignore file